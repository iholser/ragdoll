# Database Configuration
DATABASE_URL=postgresql://ragdoll:ragdoll@localhost:5432/ragdoll
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ragdoll
POSTGRES_USER=ragdoll
POSTGRES_PASSWORD=ragdoll

# ChromaDB Configuration (Development)
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_DB_IMPL=duckdb+parquet
CHROMA_PERSIST_DIRECTORY=./chroma_data

# AI Provider Configuration
# Primary: Amazon Bedrock
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
BEDROCK_MODEL_ID=anthropic.claude-3-sonnet-20240229-v1:0

# Alternative: Ollama (Local)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama2:7b

# Server Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
JWT_SECRET=your_jwt_secret_key_here
CORS_ORIGIN=http://localhost:3001

# Widget Configuration
WIDGET_ENDPOINT=http://localhost:3000
WIDGET_ALLOWED_ORIGINS=http://localhost:3001,https://yourdomain.com

# External Integrations
ZENDESK_SUBDOMAIN=your_zendesk_subdomain
ZENDESK_EMAIL=your_zendesk_email
ZENDESK_API_TOKEN=your_zendesk_api_token

# Email Configuration (AWS SES)
SES_FROM_EMAIL=noreply@yourdomain.com
SES_REGION=us-east-1

# Webhook Configuration
WEBHOOK_SECRET=your_webhook_secret

# File Upload Configuration
MAX_FILE_SIZE=10485760  # 10MB
ALLOWED_FILE_TYPES=pdf,doc,docx,txt,md
UPLOAD_DIR=./uploads

# Logging
LOG_LEVEL=info
LOG_FORMAT=json
